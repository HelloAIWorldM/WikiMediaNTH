ntent [style*=\"; color: #6b7b90\"],.post__content font[color=\"#6b7b90\"]{color:#55657a!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #6b7b90\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #6b7b90\"],html[data-theme=\"dark\"] .post__content font[color=\"#6b7b90\"]{color:#b9c7d3!important}.post__content [style^=\"color: #e62483\"],.post__content [style*=\"; color: #e62483\"],.post__content font[color=\"#e62483\"]{color:#b5175f!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #e62483\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #e62483\"],html[data-theme=\"dark\"] .post__content font[color=\"#e62483\"]{color:#ff86c0!important}.post__content [style^=\"color: #8a6d4a\"],.post__content [style*=\"; color: #8a6d4a\"],.post__content font[color=\"#8a6d4a\"]{color:#6e5536!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #8a6d4a\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #8a6d4a\"],html[data-theme=\"dark\"] .post__content font[color=\"#8a6d4a\"]{color:#d9bf98!important}.post__content li::marker{color:#2f6f66}html[data-theme=\"dark\"] .post__content li::marker{color:#8fd8c7}html[data-theme=\"dark\"] .post__content [style*=\"background: #ffffff\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #ffffff\"],html[data-theme=\"dark\"] .post__content [style*=\"background: #fffaf0\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fffaf0\"],html[data-theme=\"dark\"] .post__content [style*=\"background: #fff7e6\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff7e6\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff4d6\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff7e8\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff3cd\"]{background:rgba(255,255,255,.06)!important;border-color:rgba(143,216,199,.35)!important}html[data-theme=