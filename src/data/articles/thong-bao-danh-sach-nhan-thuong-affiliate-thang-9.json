\"dark\"] .post__content [style^=\"color: #1f4f49\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #1f4f49\"]{color:#cfeee6!important}html[data-theme=\"dark\"] .post__content table,html[data-theme=\"dark\"] .post__content td,html[data-theme=\"dark\"] .post__content th{border-color:rgba(143,216,199,.3)!important}html[data-theme=\"dark\"] .nth-dl>div{background:rgba(8,26,24,.55)!important;box-shadow:inset 0 0 0 1px rgba(143,216,199,.55),0 8px 24px rgba(0,0,0,.35)!important}html[data-theme=\"dark\"] .nth-dl .nth-dl-h{color:#d9fff5!important}html[data-theme=\"dark\"] .nth-dl a{box-shadow:inset 0 0 0 1px #8fd8c7,inset 0 0 0 3px #0c2623,inset 0 0 0 4px rgba(143,216,199,.55),0 0 0 1px rgba(143,216,199,.35),0 4px 14px rgba(0,0,0,.5)!important}html[data-theme=\"dark\"] .nth-dl .nth-dl-pc{box-shadow:none!important;filter:drop-shadow(0 4px 12px rgba(0,0,0,.45))}</style><!-- /nth-theme-2026 -->\n<div class=\"tl\" lang=\"vi\">\n<style>\n.tl:not(.is-en) .tl-en,.tl.is-en .tl-vi,.tl .tl-title-en{display:none!important}\n.tl .tl-bar{display:none;justify-content:flex-end;align-items:center;margin:0 0 .35em;line-height:1}\n.tl.js .tl-bar{display:flex}\n/* khung trắng nhẹ như ô footer nth-dl-2026, nút đang chọn xanh lá */\n.tl .tl-sw{display:inline-flex;gap:4px;padding:4px;border-radius:10px;background:rgba(255,255,255,.62);\n  box-shadow:inset 0 0 0 1px rgba(143,216,199,.75),0 4px 12px rgba(31,79,73,.12);line-height:1}\nhtml[data-theme=\"dark\"] .tl .tl-sw{background:rgba(255,255,255,.14)}\n.tl .tl-btn{display:block;padding:9px 16px;border-radius:7px;font:700 14px/1 'Be Vietnam Pro','Barlow',Arial,sans-serif!important;letter-spacing:.06em;text-transform:uppercase;color:#1f4f49!important;text-decoration:none!important;cursor:pointer;transition:background .2s,color .2s}\nhtml[data-theme=\"dark\"] .tl .tl-btn{color:#d9fff5!important}\n.tl .tl-btn:hover{background:rgba(143,216,199,.25)}\n.tl .tl-btn.is-on{color:#fff!important;background:linear-gradient(180deg,#14a86f,#01875f);box-shadow:0 2px 0 #016446,0 3px 8px rgba(1,135,95,.3)}\n.tl .tl-btn:focus-visible{outline:2px solid #14a86f;outline-offset:2px}\n@media (max-width:560px){.tl .tl-btn{padding:8px 12px;font-size:13px!important}}\n/* nhãn thẻ PC trong footer: bản Anh dài hơn, giữ một dòng */\n.tl .nth-dl-pc .tl-en{white-space:nowrap;font-size:.8em}\n</style>\n<div class=\"tl-bar\"><div class=\"tl-sw\" role=\"group\" aria-label=\"Ngôn ngữ / Language\"><a class=\"tl-btn tl-set-vi\" href=\"#lang=vi\" role=\"button\">Tiếng Việt</a><a class=\"tl-btn tl-set-en\" href=\"#lang=en\" role=\"button\">English</a></div></div>\n<span class=\"tl-title-en\">SEPTEMBER AFFILIATE REWARD LIST ANNOUNCEMENT</span>\n<div class=\"tl-vi\">\n<div class=\"aff-winners\" style=\"color: #44546a; line-height: 1.7;\">\n<p style=\"margin: 0 0 10px;\">Ban Tổ Chức đã hoàn tất tổng hợp hoa hồng chương trình <strong style=\"color: #1f4f49;\">Affiliate Nghịch Thủy Hàn</strong> kỳ <strong style=\"color: #1f4f49;\">tháng 9/2026</strong>. Xin chúc mừng <strong style=\"color: #1f4f49;\">11 Thiếu Hiệp</strong> dưới đây đã hoàn tất thông tin nhận thưởng và đủ điều kiện nhận phần thưởng tiền mặt!</p>\n<p style=\"margin: 0 0 10px;\">Ban Tổ Chức xin cảm ơn toàn thể Thiếu Hiệp đã tích cực chiêu mộ đồng đạo, cùng xây dựng cộng đồng Nghịch Thủy Hàn ngày một lớn mạnh.</p>\n<h3 style=\"color: #e67e23; font-size: 14pt; font-weight: bold; margin: 26px 0 12px;\">I. Danh Sách Nhận Thưởng</h3>\n<p style=\"margin: 0 0 10px;\">Danh sách được sắp xếp theo giá trị phần thưởng từ cao đến thấp.</p>\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"9\" style=\"border-collapse: collapse; text-align: center; width: 100%; margin: 8px 0 14px; border: 1px solid #3f5a78;\">\n<thead>\n<tr>\n<th style=\"background: rgba(255,255,255,.95); color: #1f4f49; border: 1px solid #3f5a78; padding: 10px;\">STT</th>\n<th style=\"background: rgba(255,255,255,.95); color: #1f4f49; border: 1px solid #3f5a78; padding: 10px;\">Tên nhân vật</th>\n<th style=\"background: rgba(255,255,255,.95); color: #1f4f49; border: 1px solid #3f5a78; padding: 10px;\">Số tiền nhận thưởng</th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"background: rgba(255,244,214,.85);\">\n<td style=\"border: 1px solid #3f5a78;\"><strong style=\"color: #c98716;\">1</strong></td>\n<td style=\"border: 1px solid #3f5a78;\"><strong style=\"color: #c98716;\">Mò Mò</strong> <span style=\"color: #e67e23;\">★ Partner</span></td>\n<td style=\"border: 1px solid #3f5a78;\"><strong style=\"color: #c98716;\">384.000 VND</strong></td>\n</tr>\n<tr>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\">2</td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\"><strong style=\"color: #1f4f49;\">NPxDyeus</strong></td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\">312.000 VND</td>\n</tr>\n<tr style=\"background: rgba(255,244,214,.85);\">\n<td style=\"border: 1px solid #3f5a78;\"><strong style=\"color: #c98716;\">3</strong></td>\n<td style=\"border: 1px solid #3f5a78;\"><strong style=\"color: #c98716;\">Thái Arch</strong> <span style=\"color: #e67e23;\">★ Partner</span></td>\n<td style=\"border: 1px solid #3f5a78;\"><strong style=\"color: #c98716;\">188.000 VND</strong></td>\n</tr>\n<tr>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\">4</td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\"><strong style=\"color: #1f4f49;\">许青</strong></td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\">150.000 VND</td>\n</tr>\n<tr>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.55);\">5</td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.55);\"><strong style=\"color: #1f4f49;\">S hān</strong></td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.55);\">100.000 VND</td>\n</tr>\n<tr>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\">6</td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\"><strong style=\"color: #1f4f49;\">Chu Diên</strong></td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\">96.000 VND</td>\n</tr>\n<tr>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.55);\">7</td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.55);\"><strong style=\"color: #1f4f49;\">Lục Vũ Y Y</strong></td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.55);\">44.000 VND</td>\n</tr>\n<tr>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\">8</td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\"><strong style=\"color: #1f4f49;\">Zhou Hấu</strong></td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\">30.000 VND</td>\n</tr>\n<tr>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.55);\">9</td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.55);\"><strong style=\"color: #1f4f49;\">Mấy con cá</strong></td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.55);\">22.000 VND</td>\n</tr>\n<tr>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\">10</td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\"><strong style=\"color: #1f4f49;\">Nhan Mộng Trúc</strong></td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.7);\">14.000 VND</td>\n</tr>\n<tr>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.55);\">11</td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.55);\"><strong style=\"color: #1f4f49;\">Vũ Huyền Dương</strong></td>\n<td style=\"border: 1px solid #3f5a78; background: rgba(255,255,255,.55);\">10.000 VND</td>\n</tr>\n</tbody>\n</table>\n<p style=\"margin: 0 0 8px;\"><em style=\"color: #6b7b90;\">Số tiền trên là hoa hồng Affiliate mà Thiếu Hiệp tích lũy được trong kỳ tháng 9/2026.</em></p>\n<h3 style=\"color: #e67e23; font-size: 14pt; font-weight: bold; margin: 26px 0 12px;\">II. Về Đặc Quyền Creator</h3>\n<p style=\"margin: 0 0 10px;\">Hai Thiếu Hiệp được đánh dấu <strong style=\"color: #e67e23;\">★ Partner</strong> trong bảng trên là các Thiếu Hiệp đang đồng hành cùng Nghịch Thủy Hàn với vai trò Creator Partner. Phần thưởng của các Thiếu Hiệp này được tính theo <strong style=\"color: #1f4f49;\">mức hoa hồng ưu đãi dành riêng cho Partner</strong>:</p>\n<ul style=\"margin: 0 0 10px; padding-left: 24px;\">\n<li style=\"margin-bottom: 6px;\">Hưởng <strong style=\"color: #1f4f49;\">4.000đ cho mỗi 100.000đ</strong> giá trị nạp của người được chiêu mộ, gấp đôi mức thông thường.</li>\n<li style=\"margin-bottom: 6px;\">Giới hạn hoa hồng trên mỗi người được chiêu mộ được nâng lên <strong style=\"color: #1f4f49;\">420.000đ</strong>, thay vì mức thông thường.</li>\n<li style=\"margin-bottom: 6px;\">Các khoản thưởng khác như thẻ tháng vẫn áp dụng như quy định chung của chương trình.</li>\n</ul>\n<p style=\"margin: 0 0 10px;\">Thiếu Hiệp có kênh nội dung về Nghịch Thủy Hàn và mong muốn tham gia chương trình Creator, <a href=\"https://nghichthuyhancreators.vnggames.com/\" target=\"_blank\" rel=\"noopener\">vui lòng tham khảo tại đây.</a></p>\n<h3 style=\"color: #e67e23; font-size: 14pt; font-weight: bold; margin: 26px 0 12px;\">III. Hình Thức Trao Thưởng</h3>\n<ul style=\"margin: 0 0 10px; padding-left: 24px;\">\n<li style=\"margin-bottom: 6px;\">Phần thưởng tiền mặt được <strong style=\"color: #1f4f49;\">chuyển khoản</strong> theo đúng thông tin tài khoản ngân hàng mà Thiếu Hiệp đã cung cấp trong form nhận thưởng.</li>\n<li style=\"margin-bottom: 6px;\">Thiếu Hiệp vui lòng kiểm tra lại <strong style=\"color: #1f4f49;\">số tài khoản, tên chủ tài khoản và chi nhánh ngân hàng</strong> của mình. Thông tin sai hoặc thiếu Tỉnh/Thành của chi nhánh sẽ khiến việc trao thưởng bị gián đoạn.</li>\n<li style=\"margin-bottom: 6px;\">Thiếu Hiệp <strong style=\"color: #1f4f49;\">chưa có tên trong danh sách</strong> nhưng đã phát sinh hoa hồng Affiliate trong kỳ tháng 9 vui lòng truy cập trang sự kiện và bấm vào nút <strong style=\"color: #1f4f49;\">Thông Tin Nhận Thưởng</strong> để bổ sung thông tin nhận thưởng.</li>\n<li style=\"margin-bottom: 6px;\"><strong style=\"color: #e03e2d;\">Ban Tổ Chức và Nghịch Thủy Hàn KHÔNG BAO GIỜ yêu cầu Thiếu Hiệp cung cấp mật khẩu, mã OTP hay mã xác thực giao dịch để nhận thưởng. Thiếu Hiệp</strong> hãy cảnh giác với mọi tin nhắn, cuộc gọi giả mạo.</li>\n<li style=\"margin-bottom: 6px;\">Tài khoản vi phạm điều khoản dịch vụ, sử dụng công cụ gian lận hoặc tự chiêu mộ khống để trục lợi hoa hồng sẽ bị hủy tư cách dự thưởng và thu hồi phần thưởng (nếu đã trao).</li>\n<li style=\"margin-bottom: 6px;\">Mọi thắc mắc, Thiếu Hiệp vui lòng liên hệ CSKH Nghịch Thủy Hàn (hotline 1900 561 558) hoặc fanpage chính thức để được hỗ trợ. Trong mọi trường hợp tranh chấp phát sinh, quyết định cuối cùng thuộc về Ban Tổ Chức Nghịch Thủy<strong style=\"color: #1f4f49;\"></strong> Hàn.</li>\n</ul>\n<p style=\"margin: 16px 0 0;\">Chúc Thiếu Hiệp một hành trình giang hồ thật nhiều may mắn!</p>\n</div>\n<hr style=\"border:0;height:1px;margin:22px auto;max-width:70%;background:linear-gradient(90deg,transparent,#8fd8c7,transparent);\">\n<style>\n  .download-group { display: flex; justify-content: center; align-items: center; gap: 16px; flex-wrap: wrap; margin: 16px 0; }\n  .download-col { display: flex; flex-direction: column; gap: 12px; }\n  .download-group a { display: flex; justify-content: center; align-items: center; overflow: hidden; border-radius: 12px; transition: transform 0.25s ease, box-shadow 0.25s ease; }\n  .download-group img { display: block; width: 100%; height: auto; transition: transform 0.25s ease; }\n  .download-group a:hover { transform: scale(1.05); box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.25); }\n  .download-group a:hover img { transform: scale(1.05); }\n  .btn-store { width: 300px; }\n  .btn-pc { width: 220px; }\n  @media (max-width: 640px){ .download-group { flex-direction: column; } .download-col { align-items: center; } }\n  .social-links { display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; }\n  .social-links a { display: flex; justify-content: center; align-items: center; width: 60px; height: 60px; border-radius: 50%; overflow: hidden; transition: transform 0.25s ease, box-shadow 0.25s ease; }\n  .social-links img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.25s ease; }\n  .social-links a:hover { transform: scale(1.1); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3); }\n  .social-links a:hover img { transform: scale(1.05); }\n</style>\n</div>\n<div class=\"tl-en\" lang=\"en\">\n<div class=\"aff-winners\" style=\"color: #44546a; line-height: 1.7;\">\n<p style=\"margin: 0 0 10px;\">The Organizers have finished calculating commissions for the <strong style=\"color: #1f4f49;\">Sword of Justice Affiliate</strong> program for the <strong style=\"color: #1f4f49;\">September 2026</strong>period. Congratulations to the <strong style=\"color: #1f4f49;\">11 Young Heroes</strong> below who have completed their reward information and qualify for cash rewards!</p>\n<p style=\"margin: 0 0 10px;\">The Organizers would like to thank all Young Heroes for actively recruiting fellow players and helping the Sword of Justice community grow stronger every day.</p>\n<h3 style=\"color: #e67e23; font-size: 14pt; font-weight: bold; margin: 26px 0 12px;\">I. Reward List</h3>\n<p style=\"margin: 0 0 10px;\">The list is sorted by reward amount from highest to lowest.</p>\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"9\" style=\"border-collapse: collapse; text-align: center; width: 100%; margin: 8px 0 14px; border: 1px solid #3f5a78;\">\n<thead>\n<tr>\n<th style=\"background: rgba(255,255,255,.95); color: #1f4f49; border: 1px solid #3f5a78; padding: 10px;\">No.</th>\n<th style=\"background: rgba(255,255,255,.95); color: #1f4f49