  "contentHtml": "<!-- nth-theme-2026 --><style>.post__content [style^=\"color: #e67e23\"],.post__content [style*=\"; color: #e67e23\"],.post__content font[color=\"#e67e23\"]{color:#b85a10!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #e67e23\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #e67e23\"],html[data-theme=\"dark\"] .post__content font[color=\"#e67e23\"]{color:#f3a35c!important}.post__content [style^=\"color: #c98716\"],.post__content [style*=\"; color: #c98716\"],.post__content font[color=\"#c98716\"]{color:#8f5e00!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #c98716\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #c98716\"],html[data-theme=\"dark\"] .post__content font[color=\"#c98716\"]{color:#e9bb5c!important}.post__content [style^=\"color: #236fa1\"],.post__content [style*=\"; color: #236fa1\"],.post__content font[color=\"#236fa1\"]{color:#1d5f8c!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #236fa1\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #236fa1\"],html[data-theme=\"dark\"] .post__content font[color=\"#236fa1\"]{color:#86c8f2!important}.post__content [style^=\"color: #e03e2d\"],.post__content [style*=\"; color: #e03e2d\"],.post__content font[color=\"#e03e2d\"]{color:#b3261e!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #e03e2d\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #e03e2d\"],html[data-theme=\"dark\"] .post__content font[color=\"#e03e2d\"]{color:#ff8b7c!important}.post__content [style^=\"color: #44546a\"],.post__content [style*=\"; color: #44546a\"],.post__content font[color=\"#44546a\"]{color:#3b4a5e!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #44546a\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #44546a\"],html[data-theme=\"dark\"] .post__content font[color=\"#44546a\"]{color:#b9c7d3!important}.post__content [style^=\"color: #6b7b90\"],.post__content [style*=\"; color: #6b7b90\"],.post__content font[color=\"#6b7b90\"]{color:#55657a!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #6b7b90\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #6b7b90\"],html[data-theme=\"dark\"] .post__content font[color=\"#6b7b90\"]{color:#b9c7d3!important}.post__content [style^=\"color: #e62483\"],.post__content [style*=\"; color: #e62483\"],.post__content font[color=\"#e62483\"]{color:#b5175f!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #e62483\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #e62483\"],html[data-theme=\"dark\"] .post__content font[color=\"#e62483\"]{color:#ff86c0!important}.post__content [style^=\"color: #8a6d4a\"],.post__content [style*=\"; color: #8a6d4a\"],.post__content font[color=\"#8a6d4a\"]{color:#6e5536!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #8a6d4a\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #8a6d4a\"],html[data-theme=\"dark\"] .post__content font[color=\"#8a6d4a\"]{color:#d9bf98!important}.post__content li::marker{color:#2f6f66}html[data-theme=\"dark\"] .post__content li::marker{color:#8fd8c7}html[data-theme=\"dark\"] .post__content [style*=\"background: #ffffff\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #ffffff\"],html[data-theme=\"dark\"] .post__content [style*=\"background: #fffaf0\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fffaf0\"],html[data-theme=\"dark\"] .post__content [style*=\"background: #fff7e6\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff7e6\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff4d6\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff7e8\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff3cd\"]{background:rgba(255,255,255,.06)!important;border-color:rgba(143,216,199,.35)!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #1f4f49\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #1f4f49\"]{color:#cfeee6!important}html[data-theme=\"dark\"] .post__content table,html[data-theme=\"dark\"] .post__content td,html[data-theme=\"dark\"] .post__content th{border-color:rgba(143,216,199,.3)!important}html[data-theme=\"dark\"] .nth-dl>div{background:rgba(8,26,24,.55)!important;box-shadow:inset 0 0 0 1px rgba(143,216,199,.55),0 8px 24px rgba(0,0,0,.35)!important}html[data-theme=\"dark\"] .nth-dl .nth-dl-h{color:#d9fff5!important}html[data-theme=\"dark\"] .nth-dl a{box-shadow:inset 0 0 0 1px #8fd8c7,inset 0 0 0 3px #0c2623,inset 0 0 0 4px rgba(143,216,199,.55),0 0 0 1px rgba(143,216,199,.35),0 4px 14px rgba(0,0,0,.5)!important}html[data-theme=\"dark\"] .nth-dl .nth-dl-pc{box-shadow:none!important;filter:drop-shadow(0 4px 12px rgba(0,0,0,.45))}</style><!-- /nth-theme-2026 -->\r\n<p><span style=\"font-weight: 400;\">Xin chào các đồng môn!</span></p>\r\n<p><span style=\"font-weight: 400;\">Nhiều đồng môn gần đây nhờ Tiểu Hàn giải thích rõ cơ chế của hệ thống nội công. Vì vậy, Tiểu Hàn đã tranh thủ cả đêm để tổng hợp lại toàn bộ thông tin. Nếu bên cạnh bạn có bạn bè hoặc người quen cũng cần bộ hướng dẫn này, đừng ngần ngại chia sẻ giúp họ nhé!</span></p>\r\n<h2 class=\"emoji__title\" style=\"font-size: 18pt; margin-top: 10px; margin-bottom: 5px;\"><span style=\"display: inline-flex; align-items: center;\"><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/News/bulletla.png\" alt=\"\" width=\"50\" height=\"28\" style=\"margin-right: 10px;\"> <strong>Cơ Chế Hệ Thống Nội Công</strong></span></h2>\r\n<p><span style=\"font-weight: 400;\">Trong Nghịch Thủy Hàn, nội công là một phần cực kỳ quan trọng trong tiến trình phát triển nhân vật. Nó bao gồm nhiều yếu tố như cơ chế bị động, các chỉ số cộng thêm, cùng hàng loạt thuộc tính cốt lõi khác. Nhờ vậy, hệ thống nội công tạo ra vô số biến hóa trong phong cách chiến đấu và xây dựng võ học. Với bất kỳ người chơi nào muốn tăng lực chiến và nuôi dưỡng nhân vật, nội công là bài học bắt buộc.</span></p>\r\n<p><span style=\"font-weight: 400;\">Tiểu Hàn nhận thấy nhiều người chơi, khi đối diện với số lượng nội công quá phong phú, thường cảm thấy mông lung, không biết nên bắt đầu từ đâu. Đừng lo, Tiểu Hàn sẽ giải thích thật rõ ràng và dễ hiểu. Trước tiên là phiên bản rút gọn:</span></p>\r\n<p><span style=\"color: #e67e23;\"><b>Phối nội công thế nào?</b></span><span style=\"font-weight: 400;\"><span style=\"color: #e67e23;\"> </span>Mỗi nội công đều có ngũ hành. Khi tổng số ngũ hành từ các nội công trang bị đạt mức nhất định, bạn sẽ kích hoạt được Chu Thiên. Hãy ưu tiên kích hoạt Chu Thiên đạt tối đa cấp. Giai đoạn sau hãy hướng đến mục tiêu kích hoạt đủ hai Chu Thiên tối đa, rồi mới tính đến đặc tính nội công.</span></p>\r\n<p><span style=\"color: #e67e23;\"><b>Lấy nội công ở đâu?</b></span><span style=\"font-weight: 400;\"> Nội công màu vàng rất dễ kiếm. Bạn có thể nhận từ phó bản, đấu hạng, thế giới thủ lĩnh, thân phận, các boss ngoài trời, khám phá thế giới hay từ nhiều cửa hàng trao đổi. Nguồn cung cấp vô cùng phong phú.</span></p>\r\n<p><span style=\"font-weight: 400;\">Nếu bạn vẫn thấy hai câu trên hơi khó hiểu, vậy hãy tiếp tục đọc phần giải thích chi tiết bên dưới. Đảm bảo xong phần này, bạn sẽ nắm vững toàn bộ hệ thống nội công!</span></p>\r\n<h3 class=\"emoji__title\" style=\"font-size: 16pt; margin-top: 10px; margin-bottom: 5px;\"><span style=\"display: inline-flex; align-items: center;\"> <img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/News/bulletvuong.png\" alt=\"\" width=\"20\" height=\"20\" style=\"margin-right: 10px;\"> <strong>Nội Công Là Gì?</strong></span></h3>\r\n<p><span style=\"font-weight: 400;\">Nói một cách đơn giản, nội công là tuyến nuôi dưỡng nhân vật tập trung vào cơ chế bị động và tăng chỉ số. Khi trang bị nội công, sức mạnh chiến đấu của nhân vật sẽ được cải thiện.</span></p>\r\n<p><span style=\"font-weight: 400;\">Một nội công bao gồm bốn thành phần: </span><b>đặc tính nội công</b><span style=\"font-weight: 400;\">, </span><b>thuộc tính chính</b><span style=\"font-weight: 400;\">, </span><b>các thuộc tính phụ</b><span style=\"font-weight: 400;\">, và </span><b>nguyên tố ngũ hành đi kèm</b><span style=\"font-weight: 400;\">.</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/284-phan-tich-chi-tiet-he-thong-noi/1.png\" alt=\"\" width=\"401\" height=\"656\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><i><span style=\"font-weight: 400;\">(Trong hình: phần màu đỏ là đặc tính nội công, màu xanh lá là thuộc tính chính, màu cam là thuộc tính phụ)</span></i></p>\r\n<p><span style=\"color: #e67e23;\"><b>① Đặc tính nội công:</b></span><span style=\"font-weight: 400;\"> Mỗi nội công đều có sẵn một đặc tính riêng, thường là hiệu ứng bị động. Cứ mỗi 10 cấp, hiệu quả đặc tính sẽ tăng lên một lần.</span></p>\r\n<p><b><span style=\"color: #e67e23;\">② Thuộc tính chính:</span> </b><span style=\"font-weight: 400;\">Thuộc tính chính của nội công cố định là </span><b>Giới hạn HP</b><span style=\"font-weight: 400;\">, và sẽ tăng theo mỗi lần lên cấp.</span></p>\r\n<p><span style=\"color: #e67e23;\"><b>③ Thuộc tính phụ</b></span><span style=\"font-weight: 400;\"><span style=\"color: #e67e23;\">:</span> Thuộc tính phụ của nội công xuất hiện ngẫu nhiên, có thể xem trước toàn bộ thuộc tính trong giao diện Võ công – Nội Công – Giao Diện Nâng Cấp.</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/284-phan-tich-chi-tiet-he-thong-noi/2.png\" alt=\"\" width=\"800\" height=\"518\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"color: #e67e23;\"><b>④ Nguyên tố chứa trong nội công:</b></span><span style=\"font-weight: 400;\"><span style=\"color: #e67e23;\"> </span>Mỗi nội công chứa một số lượng ngũ hành nhất định, dùng để kích hoạt Chu Thiên. Mỗi 10 cấp sẽ nhận thêm một nguyên tố mới. Hầu hết các nội công đều có nguyên tố cố định; nếu có dấu hỏi, nghĩa là nguyên tố đó sẽ được chọn ngẫu nhiên trong ngũ hành.</span></p>\r\n<p><span style=\"font-weight: 400;\">Lấy nội công </span><b>Xung Hư</b><span style=\"font-weight: 400;\"> làm ví dụ: nội công này mặc định có hai nguyên tố Kim, một nguyên tố Mộc, khi lên cấp 10 sẽ nhận thêm một Mộc, lên cấp 20 sẽ ngẫu nhiên nhận một nguyên tố trong ngũ hành.</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/284-phan-tich-chi-tiet-he-thong-noi/3.png\" alt=\"\" width=\"502\" height=\"305\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"color: #e67e23;\"><b>⑤ Phẩm chất nội công: </b></span><span style=\"font-weight: 400;\">Cùng một loại nội công được chia thành bốn phẩm chất: Lam/Đỏ/Tím/Kim. Thông thường kim là tốt nhất, lam là thấp nhất. Tất cả nội công cùng tên đều là cùng một loại.</span></p>\r\n<p><span style=\"font-weight: 400;\">Nội công được phân bố khắp giang hồ: mở rương, giải đố, làm nhiệm vụ… đều có thể nhận được. Sau khi sở hữu nội công, bạn có thể vào </span><b>Menu → Võ công → Nội công</b><span style=\"font-weight: 400;\">, rồi nhấn dấu “+” quanh nhân vật để tiến hành trang bị.</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/284-phan-tich-chi-tiet-he-thong-noi/4.webp\" alt=\"\" width=\"802\" height=\"451\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"font-weight: 400;\">Khi chọn nội công ở bên phải, bên trái sẽ hiển thị thông tin cụ thể (đặc tính, thuộc tính, nguyên tố). Nhấn nút trang bị để lắp nội công đó.</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/284-phan-tich-chi-tiet-he-thong-noi/5.webp\" alt=\"\" width=\"796\" height=\"448\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"font-weight: 400;\">Ngoài ra, tiêu hao các nội công khác có thể cung cấp kinh nghiệm cho nội công, giúp nâng cấp. Cấp càng cao, thuộc tính càng mạnh. Nội công có cấp tối đa, đạt tới sẽ không thể nâng tiếp. Giới hạn cấp tối đa lần lượt là: Lam 10 / Đỏ 15 / Tím 20 / Kim 25. Khi tiêu hao nội công đã nâng cấp, sẽ bảo lưu</span><b> 80% </b><span style=\"font-weight: 400;\">kinh nghiệm.</span></p>\r\n<p><span style=\"font-weight: 400;\">Cấp nhân vật cũng giới hạn cấp nội công tối đa hiện tại:</span></p>\r\n<ul>\r\n<li><span style=\"font-weight: 400;\">Nhân vật cấp 1–40: nội công tối đa cấp 5</span></li>\r\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Cấp 41–46: tối đa cấp 10</span></li>\r\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Cấp 47–56: tối đa cấp 15</span></li>\r\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Cấp 57–62: tối đa cấp 20</span></li>\r\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Cấp 63 trở lên: tối đa cấp 25</span></li>\r\n</ul>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/284-phan-tich-chi-tiet-he-thong-noi/6.webp\" alt=\"\" width=\"800\" height=\"450\" style=\"display: block; margin: 25px auto;\"></p>\r\n<h3 class=\"emoji__title\" style=\"font-size: 16pt; margin-top: 10px; margin-bottom: 5px;\"><span style=\"display: inline-flex; align-items: center;\"> <img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/News/bulletvuong.png\" alt=\"\" width=\"20\" height=\"20\" style=\"margin-right: 10px;\"> <strong>Làm Sao Lựa Chọn Nội Công?</strong></span></h3>\r\n<p><span style=\"font-weight: 400;\">Chủng loại nội công vô cùng phong phú, vậy phải chọn nội công phù hợp thế nào?</span></p>\r\n<p><span style=\"font-weight: 400;\">Điều quan trọng nhất chính là phải gom đủ nguyên tố trước, để kích hoạt Chu Thiên Nội Công </span><i><span style=\"font-weight: 400;\">(để mở tính năng Chu Thiên, cần hoàn thành kỳ ngộ Kiếm Vũ Đao Sương trước)</span></i></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/284-phan-tich-chi-tiet-he-thong-noi/7.webp\" alt=\"\" width=\"800\" height=\"450\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"color: #e67e23;\"><b>Chu Thiên Nội Công:</b></span><span style=\"font-weight: 400;\"> Khi số lượng nguyên tố chứa trong các nội công đã trang bị đạt đến mức nhất định, sẽ có thể kích hoạt Chu Thiên nội công tương ứng với loại và cấp độ. Thuộc tính mang lại vô cùng mạnh. Mỗi 4 nguyên tố gom đủ sẽ kích hoạt được 1 cấp Chu Thiên, tối đa 3 cấp.</span></p>\r\n<p><span style=\"font-weight: 400;\">Ví dụ, giả sử tổng số nguyên tố trong toàn bộ nội công bạn trang bị lần lượt là:</span></p>\r\n<ul>\r\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">8 × </span><b>Thủy</b></li>\r\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">4 × </span><b>Hỏa</b></li>\r\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">1 × </span><b>Mộc</b></li>\r\n</ul>\r\n<p><span style=\"font-weight: 400;\">Thì bạn sẽ kích hoạt được:</span></p>\r\n<ul>\r\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Chu Thiên Thủy cấp 2</b></li>\r\n<li style=\"font-weight: 400;\" aria-level=\"1\"><b>Chu Thiên Hỏa cấp 1</b></li>\r\n</ul>\r\n<p><span style=\"font-weight: 400;\">Còn Mộc vì mới có 1, chưa đạt 4 nên không thể kích hoạt Chu Thiên Mộc.</span></p>\r\n<p><span style=\"font-weight: 400;\">Ở giai đoạn đầu, khi số lượng nội công chưa nhiều, hãy ưu tiên hoàn thành Chu Thiên trước, rồi mới cân nhắc đến đặc tính hay thuộc tính của từng nội công.</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/284-phan-tich-chi-tiet-he-thong-noi/8.webp\" alt=\"\" width=\"802\" height=\"451\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"color: #e67e23;\"><strong>Khuyến nghị </strong><b>nên ưu tiên đạt Chu Thiên cấp 3</b></span><span style=\"font-weight: 400;\">, vì đó là trạng thái mạnh nhất. Ở giai đoạn sau, bạn có thể đồng thời kích hoạt </span><b>hai loại Chu Thiên cấp 3</b><span style=\"font-weight: 400;\"> để đạt hiệu quả tối ưu.</span></p>\r\n<p><span style=\"font-weight: 400;\">Ngũ hành nguyên tố tương ứng với năm phong cách Chu Thiên khác nhau. Ví dụ, người chơi muốn tăng mạnh khả năng gây sát thương nên cố gắng gom đủ 12 Kim hoặc 12 Hỏa để kích hoạt Chu Thiên cấp 3 tương ứng.</span></p>\r\n<p><span style=\"font-weight: 400;\">Dưới đây Tiểu Hàn giới thiệu ngắn về các Chu Thiên phù hợp từng lưu phái~</span></p>\r\n<p><b>Chu Thiên Kim:</b><span style=\"font-weight: 400;\"> Lấy sát thương bùng nổ làm trọng tâm, đặc điểm là sốc sát thương. Các lưu phái dùng nhiều: Toái Mộng, Huyết Hà, Cửu Linh, Thần Tương (luôn dùng trong PVE cho các phái gây sát thương)</span></p>\r\n<p><b>Chu Thiên Mộc:</b><span style=\"font-weight: 400;\"> Lấy giảm hồi chiêu làm trọng tâm, đặc điểm linh động, tăng tốc vòng quay kỹ năng. Lưu phái dùng nhiều: Cửu Linh - Thần Tương (PVP), Tố Vấn, Thiết Y (PVE)</span></p>\r\n<p><b>Chu Thiên Thủy:</b><span style=\"font-weight: 400;\"> Lấy hỗ trợ làm trọng tâm, đặc điểm khống chế và trợ giúp. Lưu phái dùng nhiều: Tố Vấn</span></p>\r\n<p><b>Chu Thiên Hỏa:</b><span style=\"font-weight: 400;\"> Lấy sát thương duy trì làm trọng tâm, đặc điểm là damage-over-time. Lưu phái dùng nhiều: Toái Mộng, Huyết Hà, Cửu Linh, Thần Tương (luôn dùng trong PVE cho các phái gây sát thương)</span></p>\r\n<p><b>Chu Thiên Thổ: </b><span style=\"font-weight: 400;\">Lấy phòng ngự làm trọng tâm, đặc điểm sinh tồn và thủ vững. Lưu phái dùng nhiều: Thiết Y, Huyết Hà, Tố Vấn… (đa phần các phái đều dùng trong PVP)</span></p>\r\n<p><span style=\"font-weight: 400;\">Tất nhiên, mỗi lưu phái trong từng loại chế độ có thể có nhiều cách kết hợp nội công khác nhau, bạn có thể tự xây dựng theo phong cách chiến đấu của bản thân. Hoặc có thể “chép bài” bằng cách xem gợi ý tại giao diện Menu — Võ công — Nội công:</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/284-phan-tich-chi-tiet-he-thong-noi/9.webp\" alt=\"\" width=\"800\" height=\"450\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"font-weight: 400;\">Ngoài Chu Thiên Nội Công, bạn cũng nên chú ý tới</span><b> <span style=\"color: #e67e23;\">Đặc Tính</span></b><span style=\"font-weight: 400;\"> của từng nội công, đa số là kỹ năng bị động.</span></p>\r\n<p><span style=\"font-weight: 400;\">Ví dụ nội công</span><b> Thúc Hồn</b><span style=\"font-weight: 400;\"> có đặc tính: sau khi đánh bại người chơi khác, trong một thời gian có thể nhận buff tăng sát thương. Nếu bạn là người chơi PVE thì đặc tính này có thể không hữu dụng, trong trường hợp không ảnh hưởng Chu Thiên có thể đổi sang loại khác.</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/284-phan-tich-chi-tiet-he-thong-noi/10.png\" alt=\"\" width=\"408\" height=\"498\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"font-weight: 400;\">Cuối cùng, sau khi đã ưu tiên kích hoạt Chu Thiên và chọn đặc tính phù hợp, bạn mới bắt đầu cân nhắc thuộc tính nội công.</span></p>\r\n<p><span style=\"font-weight: 400;\">Điều này tùy thuộc phong cách chiến đấu và loại chế độ. Nếu bạn muốn theo đuổi sát thương cực hạn trong PVE, thì các thuộc tính phụ thiên về tấn công, khắc chế sẽ ưu việt hơn các chỉ số phòng ngự.</span></p>\r\n<h3 class=\"emoji__title\" style=\"font-size: 16pt; margin-top: 10px; margin-bottom: 5px;\"><span style=\"display: inline-flex; align-items: center;\"> <img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/News/bulletvuong.png\" alt=\"\" width=\"20\" height=\"20\" style=\"margin-right: 10px;\"> <strong> Làm Sao Để Có Nội Công Chất Lượng Cao?</strong></span></h3>\r\n<p><span style=\"font-weight: 400;\">Trong Nghịch Thủy Hàn, với phương châm </span><b>không bán chỉ số</b><span style=\"font-weight: 400;\"> và</span><b> trả lại thần công thần binh cho giang hồ</b><span style=\"font-weight: 400;\">, toàn bộ vật phẩm nuôi dưỡng (bao gồm cả nội công cao cấp) đều có thể thu được trực tiếp từ các hoạt động trong game.</span></p>\r\n<p><span style=\"font-weight: 400;\">Nếu bạn muốn kiếm thật nhiều nội công chất lượng, hãy chú ý:</span></p>\r\n<ul>\r\n<li><b><span style=\"color: #e67e23;\"> Phó bản:</span> </b><span style=\"font-weight: 400;\">Rèn luyện hàng ngày và thách đấu hàng tuần đều rơi rất nhiều nội công, đặc biệt phó bản tuần rơi cực nhiều nội công vàng.</span></li>\r\n<li><span style=\"color: #e67e23;\"><b> BOSS Thế Giới: </b></span><span style=\"font-weight: 400;\">Nguyên Tiên Sinh ở Đào Khê thôn, Giang Hành Khách ở Từ Châu… dùng Lệnh Ủy Thác để khiêu chiến, đều rơi ổn định nội công vàng. Không cần đánh hết, chỉ cần “chạm vào boss” một cái là nhận thưởng.</span></li>\r\n<li><b><span style=\"color: #e67e23;\"> Nghề Nghiệp:</span> </b><span style=\"font-weight: 400;\">Ví dụ chọn nghề Khảo cổ, khi bạn khai quật và bảo vệ cổ vật còn có thể đào ra nội công vàng, nội công này không cần nộp lại, có thể giữ để dùng.</span></li>\r\n<li><span style=\"color: #e67e23;\"><b> Thưởng Đấu Hạng: </b></span><span style=\"font-weight: 400;\">Theo cơ chế </span><b>Thù Đồ Đồng Quy</b><span style=\"font-weight: 400;\">, chỉ cần chọn hai trong bốn tuyến: Luận Võ Công Bằng/Nhàn Rỗi/Phó Bản/Thí Kiếm Thiên Hạ là đã có thể nhận đủ thưởng hạng, gồm cả nhiều nội công vàng.</span></li>\r\n<li><b><span style=\"color: #e67e23;\">Ngoài ra còn có:</span> </b><span style=\"font-weight: 400;\">Lâm Lang Chiến Lệnh, Truy Nã, BOSS Dã Ngoại… đều có thể rơi nội công vàng. Trong các cửa hàng như Phong Vân, Doanh Ngọc, Bang Hội cũng có thể đổi nội công. Thậm chí đang đi đường đá trúng cái bình cũng có thể rơi nội công chuẩn tốt nghiệp, tài nguyên cực kỳ dồi dào.</span></li>\r\n</ul>\r\n<p><span style=\"font-weight: 400;\">À đúng rồi, nếu bạn có chút đồng tiền, hãy xem thử kênh </span><b>Giao Dịch</b><span style=\"font-weight: 400;\"> bán nội công, có thể có người chơi khác treo lên. Bạn cũng có thể đem nội công rơi ở phó bản tổ đội đăng bán. (Lưu ý: đăng bán cần qua giai đoạn công bố, có thể xem tại Khu Công Bố)</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/284-phan-tich-chi-tiet-he-thong-noi/11.webp\" alt=\"\" width=\"800\" height=\"450\" style=\"display: block; margin: 25px auto;\"></p>\r\n<h2 class=\"emoji__title\" style=\"font-size: 18pt; margin-top: 10px; margin-bottom: 5px;\"><span style=\"display: inline-flex; align-items: center;\"><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/News/bulletla.png\" alt=\"\" width=\"50\" height=\"28\" style=\"margin-right: 10px;\"> <strong>Kết Luận</strong></span></h2>\r\n<p><span style=\"font-weight: 400;\">Sau khi nắm được toàn bộ cơ chế, quay lại hai câu tóm lược ban đầu, bạn sẽ thấy mọi thứ rõ ràng hơn rất nhiều:</span></p>\r\n<p><b>Phối nội công thế nào? </b><span style=\"font-weight: 400;\">Tất cả nội công đều có ngũ hành. Khi ghép đủ lượng ngũ hành sẽ kích hoạt Chu Thiên, ưu tiên Chu Thiên mức tối đa. Ở giai đoạn sau, hướng đến mục tiêu có </span><b>hai Chu Thiên full cấp</b><span style=\"font-weight: 400;\">, rồi hãy nghĩ đến đặc tính và thuộc tính.</span></p>\r\n<p><b>Lấy nội công ở đâu?</b><span style=\"font-weight: 400;\"> Nội công vàng rất dễ kiếm, từ phó bản, đấu hạng, thế giới thủ lĩnh, thân phận, dã ngoại, khám phá, các cửa hàng… tài nguyên cực kỳ phong phú.</span></p>\r\n<p><span style=\"font-weight: 400;\">Mọi người còn câu hỏi gì thì để lại bình luận trong bài viết này nhé~</span></p>\r\n<div style=\"display: flex; justify-content: center; align-items: center; width: 100%;\">\r\n<div style=\"display: inline-block; padding: 12px 24px; background: linear-gradient(45deg, #ff7b00, #ffb347); border: none; border-radius: 8px; font-size: 16pt; font-weight: bold; color: #ffffff; cursor: pointer; text-align: center; text-transform: uppercase; box-shadow: 0px 4px 10px rgba(0,0,0,0.2); transition: transform 0.2s ease, box-shadow 0.2s ease; margin-bottom: 15px;\"><a href=\"https://www.facebook.com/share/p/17fYW6SPjY/\" style=\"font-size: 14pt; color: #ffffff; text-decoration: none; display: block;\" target=\"_blank\" rel=\"noopener\">Bấm Vào Đây Để Hỏi Đáp Cùng Tiểu Hàn</a></div>\r\n</div>\r\n<style>\r\n  div[style*=\"inline-block\"]:hover {\r\n    transform: scale(1.05);\r\n    box-shadow: 0px 6px 15px rgba(0,0,0,0.3);\r\n  }\r\n</style>\r\n<p><span style=\"font-weight: 400;\">Thực tế, nội công còn nhiều điều đáng khám phá, ví dụ mô hình </span><b>Chu Thiên 3+3</b><span style=\"font-weight: 400;\"> có thể không phải tối ưu trong mọi gameplay, đôi khi bất ngờ lại thắng;</span></p>\r\n<p><span style=\"font-weight: 400;\">Hoặc cũng có thể dựa vào thuộc tính phụ và đặc tính để lắp nội công, ví dụ theo đuổi công kích cực hạn, phòng thủ cực hạn, kháng tính, khắc chế… chơi rất đa dạng;</span></p>\r\n<p><span style=\"font-weight: 400;\">Hoặc kết hợp cùng các kỹ năng giang hồ, đồng hành, kỹ năng trộm sách cùng trang bị để tạo nên phong cách chiến đấu độc đáo…</span></p>\r\n<p><span style=\"font-weight: 400;\">Hệ thống nội công giúp việc tốt nghiệp dễ dàng hơn, hạn chế lối chơi trùng lặp mà vẫn giàu chiều sâu. Mời mọi người phát huy trí tưởng tượng, dựa trên hiểu biết về thế giới võ hiệp để tự xây một lối build cho riêng mình, cho giang hồ này thêm trăm hoa đua nở.</span></p>\r\n<p><span style=\"font-weight: 400;\">Đồng thời, Tiểu Hàn cũng phát hiện nhiều đồng môn ưu tú đã chia sẻ những góc nhìn độc đáo và kinh nghiệm quý báu, nếu muốn tiếp tục đào sâu, mọi người có thể lên Group Facebook, Youtube và TikTok để tìm thêm nội dung liên quan về nội công.</span></p>\r\n<hr style=\"border:0;height:1px;margin:22px auto;max-width:70%;background:linear-gradient(90deg,transparent,#8fd8c7,transparent);\">\r\n<style>\r\n  /* ===== NHÓM NÚT TẢI GAME ===== */\r\n  .download-group {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    gap: 16px;\r\n    flex-wrap: wrap;\r\n    margin: 16px 0;\r\n  }\r\n\r\n  .download-col {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 12px;\r\n  }\r\n\r\n  .download-group a {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    overflow: hidden;\r\n    border-radius: 12px; /* Bo góc nhẹ để icon trông gọn hơn */\r\n    transition: transform 0.25s ease, box-shadow 0.25s ease;\r\n  }\r\n\r\n  .download-group img {\r\n    display: block;\r\n    width: 100%;\r\n    height: auto;\r\n    transition: transform 0.25s ease;\r\n  }\r\n\r\n  .download-group a:hover {\r\n    transform: scale(1.05);\r\n    box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.25);\r\n  }\r\n\r\n  .download-group a:hover img {\r\n    transform: scale(1.05);\r\n  }\r\n\r\n  /* Kích thước đề xuất */\r\n  .btn-store { width: 300px; }\r\n  .btn-pc { width: 220px; }\r\n\r\n  @media (max-width: 640px){\r\n    .download-group { flex-direction: column; }\r\n    .download-col { align-items: center; }\r\n  }\r\n\r\n  /* ===== NHÓM ICON MẠNG XÃ HỘI ===== */\r\n  .social-links {\r\n    display: flex;\r\n    justify-content: center;\r\n    gap: 15px;\r\n    flex-wrap: wrap;\r\n  }\r\n\r\n  .social-links a {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    width: 60px;\r\n    height: 60px;\r\n    border-radius: 50%;\r\n    overflow: hidden;\r\n    transition: transform 0.25s ease, box-shadow 0.25s ease;\r\n  }\r\n\r\n  .social-links img {\r\n    width: 100%;\r\n    height: 100%;\r\n    object-fit: cover;\r\n    transition: transform 0.25s ease;\r\n  }\r\n\r\n  .social-links a:hover {\r\n    transform: scale(1.1);\r\n    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);\r\n  }\r\n\r\n  .social-links a:hover img {\r\n    transform: scale(1.05);\r\n  }\r\n</style>\r\n<!-- nth-dl-2026 -->\r\n<style