  "contentHtml": "<!-- nth-theme-2026 --><style>.post__content [style^=\"color: #e67e23\"],.post__content [style*=\"; color: #e67e23\"],.post__content font[color=\"#e67e23\"]{color:#b85a10!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #e67e23\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #e67e23\"],html[data-theme=\"dark\"] .post__content font[color=\"#e67e23\"]{color:#f3a35c!important}.post__content [style^=\"color: #c98716\"],.post__content [style*=\"; color: #c98716\"],.post__content font[color=\"#c98716\"]{color:#8f5e00!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #c98716\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #c98716\"],html[data-theme=\"dark\"] .post__content font[color=\"#c98716\"]{color:#e9bb5c!important}.post__content [style^=\"color: #236fa1\"],.post__content [style*=\"; color: #236fa1\"],.post__content font[color=\"#236fa1\"]{color:#1d5f8c!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #236fa1\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #236fa1\"],html[data-theme=\"dark\"] .post__content font[color=\"#236fa1\"]{color:#86c8f2!important}.post__content [style^=\"color: #e03e2d\"],.post__content [style*=\"; color: #e03e2d\"],.post__content font[color=\"#e03e2d\"]{color:#b3261e!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #e03e2d\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #e03e2d\"],html[data-theme=\"dark\"] .post__content font[color=\"#e03e2d\"]{color:#ff8b7c!important}.post__content [style^=\"color: #44546a\"],.post__content [style*=\"; color: #44546a\"],.post__content font[color=\"#44546a\"]{color:#3b4a5e!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #44546a\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #44546a\"],html[data-theme=\"dark\"] .post__content font[color=\"#44546a\"]{color:#b9c7d3!important}.post__content [style^=\"color: #6b7b90\"],.post__content [style*=\"; color: #6b7b90\"],.post__content font[color=\"#6b7b90\"]{color:#55657a!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #6b7b90\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #6b7b90\"],html[data-theme=\"dark\"] .post__content font[color=\"#6b7b90\"]{color:#b9c7d3!important}.post__content [style^=\"color: #e62483\"],.post__content [style*=\"; color: #e62483\"],.post__content font[color=\"#e62483\"]{color:#b5175f!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #e62483\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #e62483\"],html[data-theme=\"dark\"] .post__content font[color=\"#e62483\"]{color:#ff86c0!important}.post__content [style^=\"color: #8a6d4a\"],.post__content [style*=\"; color: #8a6d4a\"],.post__content font[color=\"#8a6d4a\"]{color:#6e5536!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #8a6d4a\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #8a6d4a\"],html[data-theme=\"dark\"] .post__content font[color=\"#8a6d4a\"]{color:#d9bf98!important}.post__content li::marker{color:#2f6f66}html[data-theme=\"dark\"] .post__content li::marker{color:#8fd8c7}html[data-theme=\"dark\"] .post__content [style*=\"background: #ffffff\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #ffffff\"],html[data-theme=\"dark\"] .post__content [style*=\"background: #fffaf0\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fffaf0\"],html[data-theme=\"dark\"] .post__content [style*=\"background: #fff7e6\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff7e6\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff4d6\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff7e8\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff3cd\"]{background:rgba(255,255,255,.06)!important;border-color:rgba(143,216,199,.35)!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #1f4f49\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #1f4f49\"]{color:#cfeee6!important}html[data-theme=\"dark\"] .post__content table,html[data-theme=\"dark\"] .post__content td,html[data-theme=\"dark\"] .post__content th{border-color:rgba(143,216,199,.3)!important}html[data-theme=\"dark\"] .nth-dl>div{background:rgba(8,26,24,.55)!important;box-shadow:inset 0 0 0 1px rgba(143,216,199,.55),0 8px 24px rgba(0,0,0,.35)!important}html[data-theme=\"dark\"] .nth-dl .nth-dl-h{color:#d9fff5!important}html[data-theme=\"dark\"] .nth-dl a{box-shadow:inset 0 0 0 1px #8fd8c7,inset 0 0 0 3px #0c2623,inset 0 0 0 4px rgba(143,216,199,.55),0 0 0 1px rgba(143,216,199,.35),0 4px 14px rgba(0,0,0,.5)!important}html[data-theme=\"dark\"] .nth-dl .nth-dl-pc{box-shadow:none!important;filter:drop-shadow(0 4px 12px rgba(0,0,0,.45))}</style><!-- /nth-theme-2026 -->\n<div class=\"tl\" lang=\"vi\">\n<style>\n.tl:not(.is-en) .tl-en,.tl.is-en .tl-vi,.tl .tl-title-en{display:none!important}\n.tl .tl-bar{display:none;justify-content:flex-end;align-items:center;margin:0 0 .35em;line-height:1}\n.tl.js .tl-bar{display:flex}\n/* khung trắng nhẹ như ô footer nth-dl-2026, nút đang chọn xanh lá */\n.tl .tl-sw{display:inline-flex;gap:4px;padding:4px;border-radius:10px;background:rgba(255,255,255,.62);\n  box-shadow:inset 0 0 0 1px rgba(143,216,199,.75),0 4px 12px rgba(31,79,73,.12);line-height:1}\nhtml[data-theme=\"dark\"] .tl .tl-sw{background:rgba(255,255,255,.14)}\n.tl .tl-btn{display:block;padding:9px 16px;border-radius:7px;font:700 14px/1 'Be Vietnam Pro','Barlow',Arial,sans-serif!important;letter-spacing:.06em;text-transform:uppercase;color:#1f4f49!important;text-decoration:none!important;cursor:pointer;transition:background .2s,color .2s}\nhtml[data-theme=\"dark\"] .tl .tl-btn{color:#d9fff5!important}\n.tl .tl-btn:hover{background:rgba(143,216,199,.25)}\n.tl .tl-btn.is-on{color:#fff!important;background:linear-gradient(180deg,#14a86f,#01875f);box-shadow:0 2px 0 #016446,0 3px 8px rgba(1,135,95,.3)}\n.tl .tl-btn:focus-visible{outline:2px solid #14a86f;outline-offset:2px}\n@media (max-width:560px){.tl .tl-btn{padding:8px 12px;font-size:13px!important}}\n/* nhãn thẻ PC trong footer: bản Anh dài hơn, giữ một dòng */\n.tl .nth-dl-pc .tl-en{white-space:nowrap;font-size:.8em}\n</style>\n<div class=\"tl-bar\"><div class=\"tl-sw\" role=\"group\" aria-label=\"Ngôn ngữ / Language\"><a class=\"tl-btn tl-set-vi\" href=\"#lang=vi\" role=\"button\">Tiếng Việt</a><a class=\"tl-btn tl-set-en\" href=\"#lang=en\" role=\"button\">English</a></div></div>\n<span class=\"tl-title-en\">YINGLONG DESCENDS: LUXURY OUTFITS AND THE CHÚ TINH HUYỄN LONG DRAGON</span>\n<div class=\"tl-vi\">\n<p>Thân gửi các Thiếu Hiệp,</p>\n<p>Nghịch Thủy Hàn tròn 1 tuổi tại Việt Nam, và dịp này cần một vị khách xứng tầm. Ngày 06/11, cùng bản cập nhật 2.1.1 <strong>Huyền Cơ Vạn Biến</strong>, dòng ngoại trang cao cấp nhất <strong>Thiên Tứ</strong> chào đón chủ đề hoàn toàn mới: <strong>Ứng Long</strong>, vị thần sáng thế duy nhất của Long tộc. Đi cùng là Thiên Tứ Tường Thụy <strong>Chú Tinh Huyễn Long</strong>, con rồng ngao du giữa các vì sao.</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-kv.jpg\" alt=\"\" width=\"800\" style=\"display: block; margin: 25px auto;\"></p>\n<h2><span style=\"color: #c98716;\"><strong>Ngoại trang Thiên Tứ: Ứng Long Đình Nghê và Ứng Long Thương Linh</strong></span></h2>\n<p>Hai bộ <strong>[Ứng Long Đình Nghê]</strong> và <strong>[Ứng Long Thương Linh]</strong> hóa hình từ lớp lân giáp và đôi cánh gió của Ứng Long. Râu vảy rồng hóa thành mái tóc bạc dài buông tới eo, chiếc long quán trong suốt vươn cao trên đầu như lời khẳng định thân phận Chân Long. Ứng Long có thể tùy ý đổi tư thái, nên bộ ngoại trang cũng có nhiều kiểu cắt may để Thiếu Hiệp chuyển đổi theo ý thích.</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-02.jpg\" alt=\"\" width=\"800\" style=\"display: block; margin: 25px auto;\"></p>\n<p><strong>PK Lưng [Ứng Long Vũ Duệ].</strong> Đôi cánh và tà áo choàng cùng nhau tạo nên vẻ uy nghiêm không thể xâm phạm của Ứng Long. Thiếu Hiệp có thể tách riêng đôi cánh hoặc riêng áo choàng, thậm chí mặc chồng cả hai lớp cho thêm phần uy nghi.</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-01.jpg\" alt=\"\" width=\"800\" style=\"display: block; margin: 25px auto;\"></p>\n<p><strong>PK Mặt [Yểm Uyên Chiếu Thế].</strong> Ứng Long khoác lên chiếc mặt nạ, tiện tay dập tắt hỗn độn vừa sinh, để mặt trời nhân gian vẫn mọc như thường lệ.</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-03.jpg\" alt=\"\" width=\"800\" style=\"display: block; margin: 25px auto;\"></p>\n<h2><span style=\"color: #c98716;\"><strong>Đổi thời tiết, gọi mưa lì xì</strong></span></h2>\n<p>Món đặc biệt nhất của bộ Thiên Tứ Ứng Long là kỹ năng riêng <strong>[Sắc Lệnh Thương Khung-Đình]</strong> và <strong>[Sắc Lệnh Thương Khung-Thương]</strong>. Thi triển là đổi được thời tiết ngay khu vực Thiếu Hiệp đang đứng, kèm một cơn mưa bao lì xì khắp trời để ban phúc cho mọi người xung quanh.</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-saclenh.webp\" alt=\"\" width=\"500\" style=\"display: block; margin: 25px auto;\"></p>\n<p>Uy nghi của thần sáng thế còn nằm trong từng động tác. Động Tác đơn <strong>[Vạn Tượng Thần Tiêu]</strong>:</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-dongtacdon.webp\" alt=\"\" width=\"500\" style=\"display: block; margin: 25px auto;\"></p>\n<p>Động Tác đôi <strong>[Thiên Cổ Lôi Âm]</strong>, dành cho hai người cùng thể hiện:</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-dongtacdoi.webp\" alt=\"\" width=\"500\" style=\"display: block; margin: 25px auto;\"></p>\n<p>Và hoạt ảnh Quần Long Chi Thủ <strong>[Vạn Tượng Thần Tiêu]</strong> dành riêng cho thủ lĩnh quần long:</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-quanlong.webp\" alt=\"\" width=\"500\" style=\"display: block; margin: 25px auto;\"></p>\n<p><strong>Mở một bộ, nhận trọn gói.</strong> Mở khóa [Ứng Long Đình Nghê] hoặc [Ứng Long Thương Linh] là có luôn Hào Quang [Hạo Lân Tố Quang], Dấu Chân [Trăng Sen], PK Mặt, PK Lưng, hai động tác, kỹ năng Sắc Lệnh Thương Khung, hoạt ảnh Quần Long Chi Thủ, Dáng Đứng [Đình Thương], Trang Điểm và Avatar [Đình Nghê]/[Thương Linh].</p>\n<h2><span style=\"color: #c98716;\"><strong>Thiên Tứ Tường Thụy: rồng Chú Tinh Huyễn Long</strong></span></h2>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-rong.jpg\" alt=\"\" width=\"800\" style=\"display: block; margin: 25px auto;\"></p>\n<p>Tương truyền, <strong>[Chú Tinh Huyễn Long]</strong> ngày thường ngao du vũ trụ. Gặp tinh không chắn lối, rồng phát động thần lực nuốt trọn tất cả, chỉ để lại một hố đen.</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-rong-a.webp\" alt=\"\" width=\"560\" style=\"display: block; margin: 25px auto;\"></p>\n<p>Kỹ năng đặc biệt của rồng cũng từ đó mà ra: nuốt tinh tượng tạo hố đen, dịch chuyển tới vị trí hố đen và tự do xuyên qua giữa các hố đen. Vũ trụ vô tận cũng chỉ là sân chơi.</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-rong-c.webp\" alt=\"\" width=\"560\" style=\"display: block; margin: 25px auto;\"></p>\n<p>Khi đã du hành khắp vũ trụ, rồng tiến lên giai đoạn hai <strong>[Chú Tinh Huyễn Long-Hằng]</strong>, thánh quang bao phủ khắp nơi như lời tuyên bố: <em>Ta chính là vĩnh hằng.</em></p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-rong-b.webp\" alt=\"\" width=\"560\" style=\"display: block; margin: 25px auto;\"></p>\n<p><strong>Rồng phượng chở cả đội.</strong> Thiếu Hiệp sở hữu cả Chú Tinh Huyễn Long và phượng hoàng <strong>[Quỳnh Hoa Ngọc Hoàng]</strong> sẽ mở thêm màn bay chung: cưỡi rồng thì người thứ 5 và 6 cưỡi phượng nhỏ bay hai bên, cưỡi phượng thì người thứ 3 đến 6 cưỡi rồng nhỏ hai bên. Cả đội 6 người cùng lên trời.</p>\n<p><strong>Quà kèm theo.</strong> Sở hữu Chú Tinh Huyễn Long bậc 1 mở khóa Chủ Đề Hồ Sơ <strong>[Ngân Long Độ Lưu Quang]</strong>. Thiếu Hiệp đã có một món Thiên Tứ thì mở món Thiên Tứ tiếp theo, kể cả Tường Thụy, sẽ cần ít nguyên liệu hơn.</p>\n<p>Ngày 06/11, thần sáng thế Long tộc giáng thế mừng sinh nhật 1 tuổi của Nghịch Thủy Hàn. Hẹn gặp các Thiếu Hiệp giữa trời mưa lì xì!</p>\n<hr style=\"border:0;height:1px;margin:22px auto;max-width:70%;background:linear-gradient(90deg,transparent,#8fd8c7,transparent);\">\n<style>\n  .download-group { display: flex; justify-content: center; align-items: center; gap: 16px; flex-wrap: wrap; margin: 16px 0; }\n  .download-col { display: flex; flex-direction: column; gap: 12px; }\n  .download-group a { display: flex; justify-content: center; align-items: center; overflow: hidden; border-radius: 12px; transition: transform 0.25s ease, box-shadow 0.25s ease; }\n  .download-group img { display: block; width: 100%; height: auto; transition: transform 0.25s ease; }\n  .download-group a:hover { transform: scale(1.05); box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.25); }\n  .download-group a:hover img { transform: scale(1.05); }\n  .btn-store { width: 300px; }\n  .btn-pc { width: 220px; }\n  @media (max-width: 640px){ .download-group { flex-direction: column; } .download-col { align-items: center; } }\n  .social-links { display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; }\n  .social-links a { display: flex; justify-content: center; align-items: center; width: 60px; height: 60px; border-radius: 50%; overflow: hidden; transition: transform 0.25s ease, box-shadow 0.25s ease; }\n  .social-links img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.25s ease; }\n  .social-links a:hover { transform: scale(1.1); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3); }\n  .social-links a:hover img { transform: scale(1.05); }\n</style>\n</div>\n<div class=\"tl-en\" lang=\"en\">\n<p>Dear Young Heroes,</p>\n<p>Sword of Justice turns 1 in Vietnam, and an occasion like this calls for a worthy guest. On Nov 6, with update 2.1.1 <strong>Huyền Cơ Vạn Biến (Mystech Metamorphosis)</strong>, our most premium outfit line, <strong>Luxury</strong> , welcomes a brand new theme: <strong>Yinglong</strong>, the one and only creator god of the Dragon clan. Joining it is the Luxury Omen <strong>Chú Tinh Huyễn Long (Starforged Phantom Dragon)</strong>, a dragon that roams among the stars.</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-kv.jpg\" alt=\"\" width=\"800\" style=\"display: block; margin: 25px auto;\"></p>\n<h2><span style=\"color: #c98716;\"><strong>Luxury Outfits: Ứng Long Đình Nghê and Ứng Long Thương Linh</strong></span></h2>\n<p>The two outfits <strong>[Ứng Long Đình Nghê (Yinglong Rainbow Court)]</strong> and <strong>[Ứng Long Thương Linh (Yinglong Azure Spirit)]</strong> take shape from Yinglong's scaled armor and wind-wings. Its scaled whiskers become long silver hair flowing down to the waist, and a translucent dragon crown rises high on the head as proof of a True Dragon's identity. Yinglong can change its form at will, so the outfit also comes in several cuts for you to switch between as you like.</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-02.jpg\" alt=\"\" width=\"800\" style=\"display: block; margin: 25px auto;\"></p>\n<p><strong>Back Accessory [Ứng Long Vũ Duệ (Yinglong Featherwing)].</strong> The wings and the flowing cloak together create Yinglong's untouchable majesty. You can wear just the wings or just the cloak, or even layer both for extra grandeur.</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-01.jpg\" alt=\"\" width=\"800\" style=\"display: block; margin: 25px auto;\"></p>\n<p><strong>Face Accessory [Yểm Uyên Chiếu Thế (Abyss-Sealing Radiance)].</strong> Yinglong dons the mask and casually snuffs out a newborn chaos, so the sun of the mortal world can rise as usual.</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-03.jpg\" alt=\"\" width=\"800\" style=\"display: block; margin: 25px auto;\"></p>\n<h2><span style=\"color: #c98716;\"><strong>Change the weather, summon a red envelope rain</strong></span></h2>\n<p>The most special part of the Yinglong Luxury set is its exclusive skill <strong>[Sắc Lệnh Thương Khung-Đình (Edict of the Heavens - Court)]</strong> and <strong>[Sắc Lệnh Thương Khung-Thương (Edict of the Heavens - Azure)]</strong>. Cast it to change the weather right where you stand, along with a sky-wide shower of red envelopes to bless everyone around you.</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-saclenh.webp\" alt=\"\" width=\"500\" style=\"display: block; margin: 25px auto;\"></p>\n<p>A creator god's majesty lives in every move, too. Solo Action <strong>[Vạn Tượng Thần Tiêu (Myriad Forms of the Divine Sky)]</strong>:</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-dongtacdon.webp\" alt=\"\" width=\"500\" style=\"display: block; margin: 25px auto;\"></p>\n<p>Duo Action <strong>[Thiên Cổ Lôi Âm (Ancient Thunder Echo)]</strong>, for two people to perform together:</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-dongtacdoi.webp\" alt=\"\" width=\"500\" style=\"display: block; margin: 25px auto;\"></p>\n<p>And the Leader of Dragons MVP Animation <strong>[Vạn Tượng Thần Tiêu]</strong> made just for the leader of all dragons:</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-quanlong.webp\" alt=\"\" width=\"500\" style=\"display: block; margin: 25px auto;\"></p>\n<p><strong>Unlock one set, get the whole bundle.</strong> Unlock [Ứng Long Đình Nghê] or [Ứng Long Thương Linh] and you also get the Aura Effect [Hạo Lân Tố Quang (Pure Scaleglow)], Footprint Effect [Lotus Moon], the Face Accessory, Back Accessory, two actions, the Sắc Lệnh Thương Khung skill, the Leader of Dragons MVP Animation, Idle Pose [Đình Thương], Makeup and Avatar [Đình Nghê]/[Thương Linh].</p>\n<h2><span style=\"color: #c98716;\"><strong>Luxury Omen: the Chú Tinh Huyễn Long Dragon</strong></span></h2>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-rong.jpg\" alt=\"\" width=\"800\" style=\"display: block; margin: 25px auto;\"></p>\n<p>Legend has it that <strong>[Chú Tinh Huyễn Long]</strong> spends its days roaming the cosmos. When a starfield blocks its way, the dragon unleashes its divine power and swallows it all, leaving only a black hole behind.</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-rong-a.webp\" alt=\"\" width=\"560\" style=\"display: block; margin: 25px auto;\"></p>\n<p>That is where the dragon's special skills come from: devour constellations to create black holes, teleport to a black hole, and freely pass between black holes. Even the endless universe is just a playground.</p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-rong-c.webp\" alt=\"\" width=\"560\" style=\"display: block; margin: 25px auto;\"></p>\n<p>Once it has traveled the whole universe, the dragon advances to its second stage <strong>[Chú Tinh Huyễn Long-Hằng (Starforged Phantom Dragon - Eternal)]</strong>, bathing everything in holy light as if to declare: <em>I am eternity.</em></p>\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/NgoaiTrang/2026-10-606-ung-long-giang-the-ngoai-trang/thientu-rong-b.webp\" alt=\"\" width=\"560\" style=\"display: block; margin: 25px auto;\"></p>\n<p><strong>Dragon and phoenix carry the whole team.</strong> Own both Chú Tinh Huyễn Long and the phoenix <strong>[Quỳnh Hoa Ngọc Hoàng (Jade Blossom Phoenix)]</strong> to unlock a shared flight: when riding the dragon, players 5 and 6 ride little phoenixes on either side; when riding the phoenix, players 3 to 6 ride little dragons on either side. The whole team of 6 takes to the sky together.</p>\n<p><strong>Bonus gifts.</strong> Owning Chú Tinh Huyễn Long Tier 1 unlocks the Profile Theme <strong>[Ngân Long Độ Lưu Quang (Silver Dragon's Flowing Light)]</strong>. If you already own one Luxury item, your next Luxury item, Omens included, will need fewer materials to unlock.</p>\n<p>On Nov 6, the creator god of the Dragon clan descends to celebrate Sword of Justice's 1st birthday. See you under the red envelope rain, Young Heroes!</p>\n<hr style=\"border:0;height:1px;margin:22px auto;max-width:70%;background:linear-gradient(90deg,transparent,#8fd8c7,transparent);\">\n<style>\n  .download-group { display: flex; justify-content: center; align-items: center; gap: 16px; flex-wrap: wrap; margin: 16px 0; }\n  .download-col { display: flex; flex-direction: column; gap: 12px; }\n  .download-group a { display: flex; justify-content: center; align-items: center; overflow: hidden; border-radius: 12px; transition: transform 0.25s ease, box-shadow 0.25s ease; }\n  .download-group img { display: block; width: 100%; height: auto; transition: transform 0.25s ease; }\n  .download-group a:hover { transform: scale(1.05); box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.25); }\n  .download-group a:hover img { transform: scale(1.05); }\n  .btn-store { width: 300px; }\n  .btn-pc { width: 220px; }\n  @media (max-width: 640px){ .download-group { flex-direction: column; } .download-col { align-items: center; } }\n  .social-links { display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; }\n  .social-links a { display: flex; justify-content: center; align-items: center; width: 60px; height: 60px; border-radius: 50%; overflow: hidden; transition: transform 0.25s ease, box-shadow 0.25s ease; }\n  .social-links img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.25s ease; }\n  .social-links a:hover { transform: scale(1.1); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3); }\n  .social-links a:hover img { transform: scale(1.05); }\n</style>\n</div>\n<!-- nth-dl-2026 -->\n<style>@font-face{font-family:\"NTH Justice Mist\";src:url(https://cdn-mainsite-aka.vnggames.com/products/nghichthuyhan/mainsite/dist/assets/nth-ms26-core/fonts/nth-justice-mist-medium.woff2) format(\"woff2\");font-weight:500;font-display:swap}.nth-dl,.nth-dl *{box-sizing:border-box!important}.nth-dl a,.nth-dl span,.n