  "contentHtml": "<!-- nth-theme-2026 --><style>.post__content [style^=\"color: #e67e23\"],.post__content [style*=\"; color: #e67e23\"],.post__content font[color=\"#e67e23\"]{color:#b85a10!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #e67e23\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #e67e23\"],html[data-theme=\"dark\"] .post__content font[color=\"#e67e23\"]{color:#f3a35c!important}.post__content [style^=\"color: #c98716\"],.post__content [style*=\"; color: #c98716\"],.post__content font[color=\"#c98716\"]{color:#8f5e00!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #c98716\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #c98716\"],html[data-theme=\"dark\"] .post__content font[color=\"#c98716\"]{color:#e9bb5c!important}.post__content [style^=\"color: #236fa1\"],.post__content [style*=\"; color: #236fa1\"],.post__content font[color=\"#236fa1\"]{color:#1d5f8c!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #236fa1\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #236fa1\"],html[data-theme=\"dark\"] .post__content font[color=\"#236fa1\"]{color:#86c8f2!important}.post__content [style^=\"color: #e03e2d\"],.post__content [style*=\"; color: #e03e2d\"],.post__content font[color=\"#e03e2d\"]{color:#b3261e!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #e03e2d\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #e03e2d\"],html[data-theme=\"dark\"] .post__content font[color=\"#e03e2d\"]{color:#ff8b7c!important}.post__content [style^=\"color: #44546a\"],.post__content [style*=\"; color: #44546a\"],.post__content font[color=\"#44546a\"]{color:#3b4a5e!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #44546a\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #44546a\"],html[data-theme=\"dark\"] .post__content font[color=\"#44546a\"]{color:#b9c7d3!important}.post__content [style^=\"color: #6b7b90\"],.post__content [style*=\"; color: #6b7b90\"],.post__content font[color=\"#6b7b90\"]{color:#55657a!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #6b7b90\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #6b7b90\"],html[data-theme=\"dark\"] .post__content font[color=\"#6b7b90\"]{color:#b9c7d3!important}.post__content [style^=\"color: #e62483\"],.post__content [style*=\"; color: #e62483\"],.post__content font[color=\"#e62483\"]{color:#b5175f!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #e62483\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #e62483\"],html[data-theme=\"dark\"] .post__content font[color=\"#e62483\"]{color:#ff86c0!important}.post__content [style^=\"color: #8a6d4a\"],.post__content [style*=\"; color: #8a6d4a\"],.post__content font[color=\"#8a6d4a\"]{color:#6e5536!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #8a6d4a\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #8a6d4a\"],html[data-theme=\"dark\"] .post__content font[color=\"#8a6d4a\"]{color:#d9bf98!important}.post__content li::marker{color:#2f6f66}html[data-theme=\"dark\"] .post__content li::marker{color:#8fd8c7}html[data-theme=\"dark\"] .post__content [style*=\"background: #ffffff\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #ffffff\"],html[data-theme=\"dark\"] .post__content [style*=\"background: #fffaf0\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fffaf0\"],html[data-theme=\"dark\"] .post__content [style*=\"background: #fff7e6\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff7e6\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff4d6\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff7e8\"],html[data-theme=\"dark\"] .post__content [style*=\"background-color: #fff3cd\"]{background:rgba(255,255,255,.06)!important;border-color:rgba(143,216,199,.35)!important}html[data-theme=\"dark\"] .post__content [style^=\"color: #1f4f49\"],html[data-theme=\"dark\"] .post__content [style*=\"; color: #1f4f49\"]{color:#cfeee6!important}html[data-theme=\"dark\"] .post__content table,html[data-theme=\"dark\"] .post__content td,html[data-theme=\"dark\"] .post__content th{border-color:rgba(143,216,199,.3)!important}html[data-theme=\"dark\"] .nth-dl>div{background:rgba(8,26,24,.55)!important;box-shadow:inset 0 0 0 1px rgba(143,216,199,.55),0 8px 24px rgba(0,0,0,.35)!important}html[data-theme=\"dark\"] .nth-dl .nth-dl-h{color:#d9fff5!important}html[data-theme=\"dark\"] .nth-dl a{box-shadow:inset 0 0 0 1px #8fd8c7,inset 0 0 0 3px #0c2623,inset 0 0 0 4px rgba(143,216,199,.55),0 0 0 1px rgba(143,216,199,.35),0 4px 14px rgba(0,0,0,.5)!important}html[data-theme=\"dark\"] .nth-dl .nth-dl-pc{box-shadow:none!important;filter:drop-shadow(0 4px 12px rgba(0,0,0,.45))}</style><!-- /nth-theme-2026 -->\r\n<p><span style=\"font-weight: 400;\">Xin chào mọi người, Tiểu Hàn đây!</span></p>\r\n<p><span style=\"font-weight: 400;\">Dạo chơi cộng đồng nhiều hôm, Tiểu Hàn thấy vẫn còn nhiều đồng môn, đặc biệt là các sư huynh sư tỷ mới nhập môn vẫn còn bỡ ngỡ với lối chơi của Nghịch Thủy Hàn. Vậy nên, Tiểu Hàn quyết định làm một chuỗi nội dung Hướng Dẫn Tân Thủ (được tổng hợp nội dung từ các đại thần trong giang hồ), đảm bảo đồng môn nào đọc xong cũng trở thành cao thủ giang hồ!</span></p>\r\n<p><span style=\"font-weight: 400;\">Chủ đề đầu tiên là: </span><b>Hướng Dẫn Giao Diện &amp; Làm Sao Để Bắt Kịp Cấp Độ Nhanh Chóng</b></p>\r\n<h2 class=\"emoji__title\" style=\"font-size: 18pt; margin-top: 10px; margin-bottom: 5px;\"><span style=\"display: inline-flex; align-items: center;\"><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/News/bulletla.png\" alt=\"\" width=\"50\" height=\"28\" style=\"margin-right: 10px;\"> <strong>Hướng Dẫn Giao Diện</strong></span></h2>\r\n<p><span style=\"font-weight: 400;\">Nếu đồng môn vừa đặt chân vào Nghịch Thủy Hàn, hẳn giao diện ban đầu sẽ khiến đồng môn hơi bối rối. Thế giới này có rất nhiều thứ để khám phá, nên Tiểu Hàn sẽ hướng dẫn đồng môn tự tay thiết kế giao diện cho riêng mình.</span></p>\r\n<p><span style=\"font-weight: 400;\">Đồng môn chỉ cần vào<strong> Menu -&gt; Cài Đặt -&gt; Giao Diện -&gt; Tùy chỉnh bố cục giao diện chính</strong> là có thể tự do điều chỉnh giao diện theo ý thích của bản thân mà không có bất kỳ trở ngại nào:</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/TinTuc/2025-11-262-nghich-thuy-han-he-lo-he-thong/2.webp\" alt=\"\" width=\"600\" height=\"338\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"font-weight: 400;\">Trước tiên, giao diện UI hỗ trợ hai chế độ: Thu Gọn và Cổ Điển. Mọi người có thể chọn mẫu nền tảng tùy theo sở thích.</span></p>\r\n<p><b>Chế độ cổ điển thích hợp cho người mới:</b><span style=\"font-weight: 400;\"> có bố cục quen thuộc giống hầu hết MMORPG khác, có chú thích chữ dưới mỗi biểu tượng.</span></p>\r\n<p><b>Chế độ thu gọn thì ngược lại:</b><span style=\"font-weight: 400;\"> chỉ dùng biểu tượng làm chính, gần như không có chữ, hình ảnh trong trẻo và tinh gọn hơn.</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/TinTuc/2025-11-262-nghich-thuy-han-he-lo-he-thong/3.webp\" alt=\"\" width=\"600\" height=\"338\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"font-weight: 400;\">Dựa trên hai mẫu nền tảng này,<span style=\"color: #e67e23;\"> </span></span><span style=\"color: #e67e23;\"><b>mọi phần tử UI trên màn hình đều có thể phóng to hoặc thu nhỏ</b></span><span style=\"font-weight: 400;\">. Bạn có thể làm cho phím thường dùng nổi bật hơn, giảm nhấn nhầm. Ví dụ, khi có đại hiệp đang phát phong bì đỏ trong kênh thế giới, bạn có thể phóng to khung chat, vừa hóng chuyện vừa nhanh tay nhận lì xì! Cả màn hình game giống như miếng đất sét, tùy bạn bóp nặn, mở rộng hay thu gọn đều được.</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/TinTuc/2025-11-262-nghich-thuy-han-he-lo-he-thong/4.webp\" alt=\"\" width=\"600\" height=\"338\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"font-weight: 400;\">Đồng thời, </span><span style=\"color: #e67e23;\"><b>một số UI còn có thể điều chỉnh độ trong suốt</b></span><span style=\"font-weight: 400;\">. Nếu không muốn phần nào đó hiện trên màn hình, chỉ cần chỉnh về 0, phần ấy sẽ ẩn hoàn toàn. Ví dụ, thấy “thanh chức năng”, “thanh máu”, “thanh sự kiện” vướng mắt cứ đặt độ trong suốt 0 là biến mất ngay!</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/TinTuc/2025-11-262-nghich-thuy-han-he-lo-he-thong/5.webp\" alt=\"\" width=\"600\" height=\"338\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"font-weight: 400;\">Về góc độ tương tác, một UI tốt phải đạt chuẩn: khi không dùng thì gọn gàng, không vướng tầm nhìn; khi cần dùng, bạn có thể lập tức nhớ vị trí nút bấm và thao tác chuẩn xác mà không lo “tay loạn”.</span></p>\r\n<p><span style=\"font-weight: 400;\">Do đó, trong bản UI mới, toàn bộ phím bấm đều có thể tự do điều chỉnh vị trí: bạn muốn đặt ở đâu, cứ đặt ở đó. Không còn chuyện bạn phải làm quen với bố cục của game, mà là </span><span style=\"color: #e67e23;\"><b>để game làm quen với bạn.</b></span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/TinTuc/2025-11-262-nghich-thuy-han-he-lo-he-thong/6.webp\" alt=\"\" width=\"600\" height=\"338\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"font-weight: 400;\">Ngoài ra, </span><span style=\"color: #e67e23;\"><b>một số UI còn cho phép đổi hình dạng và phong cách</b></span><span style=\"font-weight: 400;\">. Ví dụ, nếu muốn trống hẳn góc trái dưới để điều khiển hướng di chuyển, bạn có thể chuyển “thanh chức năng” dạng dọc sang dạng ngang và kéo sang nơi khác, vừa gọn, vừa đủ tính năng.</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/TinTuc/2025-11-262-nghich-thuy-han-he-lo-he-thong/7.webp\" alt=\"\" width=\"600\" height=\"338\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"font-weight: 400;\">Nếu bạn đã thuộc lòng toàn bộ chức năng UI, thậm chí có thể đặt hầu hết UI (như thanh kỹ năng, bản đồ) sang </span><span style=\"color: #e67e23;\"><b>chế độ không văn bản</b></span><span style=\"font-weight: 400;\">, tận hưởng cảm giác “thao tác mù” một cách mượt mà.</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/TinTuc/2025-11-262-nghich-thuy-han-he-lo-he-thong/8.webp\" alt=\"\" width=\"600\" height=\"338\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p>Bên cạnh đó, khi ấn vào <strong>Chỉnh sửa nút</strong>, có thể tự do tùy chỉnh vị trí, kích cỡ chiêu thức theo sở thích của bản thân. Tiểu Hàn lấy ví dụ của một sư huynh trong cộng đồng để mọi người cùng chiêm ngưỡng:</p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/292-huong-dan-tan-thu-phan-1-giao-dien/0.webp\" alt=\"\" width=\"600\" height=\"605\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"font-weight: 400;\">Ngoài ra, các nội dung như thông tin nhân vật trên đầu, nhịp khinh công, nút trợ lý thông minh Tiểu Hàn đều có thể bật/tắt một cách tự do trong phần Cài Đặt này:</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/292-huong-dan-tan-thu-phan-1-giao-dien/1.webp\" alt=\"\" width=\"800\" height=\"314\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"font-weight: 400;\">Tóm lại, </span><b><span style=\"color: #e67e23;\">toàn bộ UI trên màn hình chính đều có thể điều chỉnh vị trí, kích cỡ, độ trong suốt và phong cách</span>.</b><span style=\"font-weight: 400;\"> Nếu lối chơi của Nghịch Thủy Hàn đã cho mọi người tự do phiêu bạt theo sở thích, thì nay giao diện UI tự do mang sự tự do ấy vào cả thao tác: mỗi người đều có thể tùy chỉnh cách thao tác và phong cách chơi của riêng mình.</span></p>\r\n<h2 class=\"emoji__title\" style=\"font-size: 18pt; margin-top: 10px; margin-bottom: 5px;\"><span style=\"display: inline-flex; align-items: center;\"><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/News/bulletla.png\" alt=\"\" width=\"50\" height=\"28\" style=\"margin-right: 10px;\"> <strong>Bí Kíp Bắt Kịp Cấp Độ Nhanh Chóng</strong></span></h2>\r\n<p><span style=\"font-weight: 400;\">Có thể nói, cấp độ là một yếu tố vừa quan trọng mà lại vừa không quan trọng trong Nghịch Thủy Hàn.</span></p>\r\n<p><span style=\"font-weight: 400;\">Quan trọng là bởi chỉ khi đạt đủ cấp độ, đồng môn mới có thể mở khóa đủ các tính năng để trải nghiệm.</span></p>\r\n<p><span style=\"font-weight: 400;\">Không quan trọng là bởi tăng cấp độ trong Nghịch Thủy Hàn rất dễ dàng, các đồng môn có thể tự do lựa chọn lối chơi để tăng cấp độ mà không chỉ đơn giản là đánh quái thăng cấp như các tựa game MMORPG truyền thống khác.</span></p>\r\n<p><span style=\"font-weight: 400;\">Vậy tân thủ mới vào Nghịch Thủy Hàn làm sao để thăng cấp thật nhanh chóng? Các đồng môn vui lòng thắt chặt dây an toàn và ngồi cẩn thận bởi vì sau đây, chuyến tàu lượn “thăng cấp” siêu tốc xin chính thức được bắt đầu:</span></p>\r\n<h3 class=\"emoji__title\" style=\"font-size: 16pt; margin-top: 10px; margin-bottom: 5px;\"><span style=\"display: inline-flex; align-items: center;\"> <img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/News/bulletvuong.png\" alt=\"\" width=\"20\" height=\"20\" style=\"margin-right: 10px;\"> <strong>Bước 1: Cấp Độ 26</strong></span></h3>\r\n<p><span style=\"font-weight: 400;\">Đối với những đồng môn mới gia nhập, mọi người sẽ phải trải qua chương mở đầu và chương 1 cốt truyện chính, là 2 chương hướng dẫn, giúp mọi người làm quen với trò chơi. Nếu đồng môn là người không thích cốt truyện, hoàn toàn có thể bấm nút bỏ qua ở góc phải trên màn hình mỗi khi có đoạn hội thoại.</span></p>\r\n<p><span style=\"font-weight: 400;\">Dù không khuyến khích, đồng môn vẫn có thể trực tiếp bỏ qua nhiệm vụ cốt truyện 2 chương này thông qua nút Tăng Tốc ở cạnh phần Nhiệm Vụ ở góc trái trên màn hình.&nbsp;</span></p>\r\n<p><span style=\"font-weight: 400;\">Sau khi hoàn thành, đồng môn có thể trực tiếp đạt cấp độ 26 trong 1 phút.</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/292-huong-dan-tan-thu-phan-1-giao-dien/2.webp\" alt=\"\" width=\"599\" height=\"322\" style=\"display: block; margin: 25px auto;\"></p>\r\n<h3 class=\"emoji__title\" style=\"font-size: 16pt; margin-top: 10px; margin-bottom: 5px;\"><span style=\"display: inline-flex; align-items: center;\"> <img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/News/bulletvuong.png\" alt=\"\" width=\"20\" height=\"20\" style=\"margin-right: 10px;\"> <strong>Bước 2: Cấp Độ 50</strong></span></h3>\r\n<p><span style=\"font-weight: 400;\">Khi đạt cấp độ 26, các đồng môn sẽ mở nhiệm vụ hàng ngày, được gọi là </span><b>Thanh Nhai Thư</b><span style=\"font-weight: 400;\">. Mỗi ngày Thanh Nhai Thư sẽ cung cấp 5 nhiệm vụ </span><b>có thể làm mới vô hạn</b><span style=\"font-weight: 400;\">.</span></p>\r\n<p><span style=\"font-weight: 400;\">Để tối ưu thời gian lên cấp, đồng môn có thể chọn 5 nhiệm vụ sau:</span></p>\r\n<ul>\r\n<li aria-level=\"1\"><b>Cốt Truyện</b><span style=\"font-weight: 400;\">: ngay lập tức hoàn thành vì đồng môn đã hoàn thành 2 chương cốt truyện mở đầu</span></li>\r\n</ul>\r\n<ul>\r\n<li aria-level=\"1\"><b>Chụp Ảnh</b><span style=\"font-weight: 400;\">: chỉ cần chụp 1 tấm ảnh thật đẹp là nhiệm vụ hoàn thành ngay chớp mắt</span></li>\r\n</ul>\r\n<ul>\r\n<li aria-level=\"1\"><b>Thám Hiểm</b><span style=\"font-weight: 400;\">: bật Vọng Khí, nhìn xung quanh, nhặt một rương, hoàn thành nhiệm vụ.</span></li>\r\n</ul>\r\n<ul>\r\n<li aria-level=\"1\"><b>Mộng Hoa Lục</b><span style=\"font-weight: 400;\">: tính năng mạng xã hội thu nhỏ trong Nghịch Thủy Hàn, chỉ cần đồng môn lên thả 1 like cũng được tính là hoàn thành rồi đó.</span></li>\r\n</ul>\r\n<ul>\r\n<li aria-level=\"1\"><b>Phó Bản</b><span style=\"font-weight: 400;\">: nghe có vẻ khó nhằn, nhưng đây sẽ là nhiệm vụ quan trọng giúp các đồng môn lên cấp 50 trong bước 2. Chỉ cần hoàn thành phó bản ngày đầu tiên - Thu Lam Họa Viện trong chưa đầy 10 phút là hoàn thành~</span></li>\r\n</ul>\r\n<p><span style=\"font-weight: 400;\">Sau khi hoàn thành 5 nhiệm vụ như trên, cấp độ của đồng môn sẽ rơi vào khoảng 50, chỉ còn thua người cũ hơn 10 cấp độ thôi nè~</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/292-huong-dan-tan-thu-phan-1-giao-dien/3.webp\" alt=\"\" width=\"800\" height=\"450\" style=\"display: block; margin: 25px auto;\"></p>\r\n<h3 class=\"emoji__title\" style=\"font-size: 16pt; margin-top: 10px; margin-bottom: 5px;\"><span style=\"display: inline-flex; align-items: center;\"> <img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/News/bulletvuong.png\" alt=\"\" width=\"20\" height=\"20\" style=\"margin-right: 10px;\"> <strong>Bước 3: Cấp Độ Tối Đa</strong></span></h3>\r\n<p><span style=\"font-weight: 400;\">Khá nhiều đồng môn gặp khó khăn sau khi hoàn thành 2 bước trên, làm sao để tăng cấp tiếp? Đánh quái mãi mà không thấy kinh nghiệm lên xíu nào.</span></p>\r\n<p><span style=\"font-weight: 400;\">Thực ra, lên cấp đơn giản hơn mọi người nghĩ, chỉ cần chọn một bản đồ mình yêu thích, nhặt 2-3 cái rương là đủ lên 1 cấp, tính ra lên 60 cũng chỉ cần nhặt 20 cái rương mà thôi. Mà thế giới Nghịch Thủy Hàn, một bước chân, một kỳ ngộ, rương báu ở khắp mọi nơi, chỉ cần dành một chút thời gian là đã đạt cấp tối đa rồi nè~&nbsp;</span></p>\r\n<p><img src=\"https://cdn-mainsite-aka.vnggames.com/upload/nghichthuyhan/source/HuongDan/292-huong-dan-tan-thu-phan-1-giao-dien/4.webp\" alt=\"\" width=\"801\" height=\"450\" style=\"display: block; margin: 25px auto;\"></p>\r\n<p><span style=\"font-weight: 400;\">Chủ đề hôm nay đến đây là kết thúc, ngày mai Tiểu Hàn sẽ giúp mọi người làm quen với hệ thống chỉ số và sức mạnh trong Nghịch Thủy Hàn nha~</span></p>\r\n<hr style=\"border:0;height:1px;margin:22px auto;max-width:70%;background:linear-gradient(90deg,transparent,#8fd8c7,transparent);\">\r\n<style>\r\n  /* ===== NHÓM NÚT TẢI GAME ===== */\r\n  .download-group {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    gap: 16px;\r\n    flex-wrap: wrap;\r\n    margin: 16px 0;\r\n  }\r\n\r\n  .download-col {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 12px;\r\n  }\r\n\r\n  .download-group a {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    overflow: hidden;\r\n    border-radius: 12px; /* Bo góc nhẹ để icon trông gọn hơn */\r\n    transition: transform 0.25s ease, box-shadow 0.25s ease;\r\n  }\r\n\r\n  .download-group img {\r\n    display: block;\r\n    width: 100%;\r\n    height: auto;\r\n    transition: transform 0.25s ease;\r\n  }\r\n\r\n  .download-group a:hover {\r\n    transform: scale(1.05);\r\n    box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.25);\r\n  }\r\n\r\n  .download-group a:hover img {\r\n    transform: scale(1.05);\r\n  }\r\n\r\n  /* Kích thước đề xuất */\r\n  .btn-store { width: 300px; }\r\n  .btn-pc { width: 220px; }\r\n\r\n  @media (max-width: 640px){\r\n    .download-group { flex-direction: column; }\r\n    .download-col { align-items: center; }\r\n  }\r\n\r\n  /* ===== NHÓM ICON MẠNG XÃ HỘI ===== */\r\n  .social-links {\r\n    display: flex;\r\n    justify-content: center;\r\n    gap: 15px;\r\n    flex-wrap: wrap;\r\n  }\r\n\r\n  .social-links a {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    width: 60px;\r\n    height: 60px;\r\n    border-radius: 50%;\r\n    overflow: hidden;\r\n    transitio